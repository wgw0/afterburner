--!strict
return function(ctx)
	local describe, it, expect = ctx.describe, ctx.it, ctx.expect
	local Units = require(ctx.Shared.Units)
	local Atmosphere = require(ctx.Shared.Atmosphere)
	local Scale = require(ctx.Shared.Config.Scale)

	describe("Units", function()
		it("velocity conversion round-trips", function()
			local v = Vector3.new(250, -10, 3)
			expect(Units.velocityFromStuds(Units.velocityToStuds(v))).toBeCloseTo(v, 1e-9)
		end)
		it("world speed is real speed × SPEED_SCALE in visual metres", function()
			local studs = Units.velocityToStuds(100)
			expect(studs / Scale.STUDS_PER_METRE).toBeCloseTo(100 * Scale.SPEED_SCALE, 1e-9)
		end)
		it("altitude and distance agree with velocity scaling (1 s at 100 m/s = 100 m)", function()
			expect(Units.toMetres(Units.velocityToStuds(100) * 1)).toBeCloseTo(100, 1e-9)
		end)
		it("the ceiling displays near 48,000 ft", function()
			local feet = Units.feet(Units.altitudeMetres(Scale.CEILING))
			expect(feet > 45000 and feet < 52000).toBe(true)
		end)
		it("display conversions", function()
			expect(Units.knots(100)).toBeCloseTo(194.3844, 1e-3)
			expect(Units.feet(1000)).toBeCloseTo(3280.84, 1e-2)
			expect(Units.kmh(10)).toBeCloseTo(36, 1e-9)
		end)
	end)

	describe("Atmosphere", function()
		it("sea level values", function()
			expect(Atmosphere.density(0)).toBeCloseTo(1.225, 1e-9)
			expect(Atmosphere.speedOfSound(0)).toBeCloseTo(340.3, 1e-9)
		end)
		it("density falls with altitude and never goes negative", function()
			expect(Atmosphere.density(5000)).toBeLessThan(Atmosphere.density(1000))
			expect(Atmosphere.density(-100)).toBeCloseTo(1.225, 1e-9)
			expect(Atmosphere.density(50000) > 0).toBe(true)
		end)
		it("speed of sound flattens above the tropopause", function()
			expect(Atmosphere.speedOfSound(11000)).toBeCloseTo(295.1, 1e-6)
			expect(Atmosphere.speedOfSound(15000)).toBeCloseTo(295.1, 1e-6)
		end)
	end)
end
