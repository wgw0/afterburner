--!strict
return function(ctx)
	local describe, it, expect = ctx.describe, ctx.it, ctx.expect
	local Validate = require(ctx.Shared.Util.Validate)

	describe("isFiniteNumber", function()
		it("accepts normal numbers", function()
			expect(Validate.isFiniteNumber(0)).toBe(true)
			expect(Validate.isFiniteNumber(-12.5)).toBe(true)
		end)
		it("rejects NaN, infinities and non-numbers", function()
			expect(Validate.isFiniteNumber(0 / 0)).toBe(false)
			expect(Validate.isFiniteNumber(math.huge)).toBe(false)
			expect(Validate.isFiniteNumber(-math.huge)).toBe(false)
			expect(Validate.isFiniteNumber("5")).toBe(false)
			expect(Validate.isFiniteNumber(nil)).toBe(false)
		end)
	end)

	describe("isInteger / inRange", function()
		it("checks integers", function()
			expect(Validate.isInteger(3)).toBe(true)
			expect(Validate.isInteger(3.5)).toBe(false)
			expect(Validate.isInteger(0 / 0)).toBe(false)
		end)
		it("checks inclusive ranges", function()
			expect(Validate.inRange(1, 1, 2)).toBe(true)
			expect(Validate.inRange(2.01, 1, 2)).toBe(false)
		end)
	end)

	describe("vectors", function()
		it("rejects vectors containing NaN", function()
			expect(Validate.isVector3(Vector3.new(1, 2, 3))).toBe(true)
			expect(Validate.isVector3(Vector3.new(0 / 0, 0, 0))).toBe(false)
			expect(Validate.isVector3({ X = 1, Y = 2, Z = 3 })).toBe(false)
		end)
		it("checks unit vectors", function()
			expect(Validate.isUnitVector(Vector3.new(0, 1, 0))).toBe(true)
			expect(Validate.isUnitVector(Vector3.new(0, 2, 0))).toBe(false)
		end)
	end)

	describe("strings", function()
		it("limits length and rejects invalid UTF-8", function()
			expect(Validate.isString("hello", 10)).toBe(true)
			expect(Validate.isString(string.rep("a", 11), 10)).toBe(false)
			expect(Validate.isString("\255\254", 10)).toBe(false)
		end)
		it("matches enum strings from arrays and sets", function()
			expect(Validate.isEnumString("Flare", { "Flare", "Chaff" })).toBe(true)
			expect(Validate.isEnumString("Bomb", { "Flare", "Chaff" })).toBe(false)
			expect(Validate.isEnumString("A", { A = true })).toBe(true)
		end)
	end)

	describe("args", function()
		it("accepts matching arguments, including omitted optionals", function()
			expect((Validate.args({ "integer", "string?" }, 1, 5))).toBe(true)
			expect((Validate.args({ "integer", "string?" }, 2, 5, "x"))).toBe(true)
		end)
		it("rejects wrong types, NaN and extra arguments", function()
			expect((Validate.args({ "integer" }, 1, "5"))).toBe(false)
			expect((Validate.args({ "number" }, 1, 0 / 0))).toBe(false)
			expect((Validate.args({ "integer" }, 2, 5, 6))).toBe(false)
			expect((Validate.args({ "integer" }, 0))).toBe(false)
		end)
		it("errors on an unknown spec (a programming mistake)", function()
			expect(function()
				Validate.matchesSpec(1, "frobnicator")
			end).toThrow("Unknown type spec")
		end)
	end)
end
