# Roblox Studio
*.rbxl.lock
*.rbxlx.lock
*.rblx.lock

# Studio auto-recovery / backups
*_AutoRecovery_*.rbxl
*.rbxl.bak

# Rojo build output (built places go here, not the root)
build/
sourcemap.json

# Wally packages (restored with `wally install`; wally.lock IS committed)
Packages/
ServerPackages/
DevPackages/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/extensions.json
.idea/

# Claude Code local settings
.claude/settings.local.json

# Blender generator output (regenerate with tools/blender/*.py)
tools/blender/out/

# Python bytecode (tools/blender scripts import each other)
__pycache__/
