# Roblox Studio
*.rbxl.lock
*.rbxlx.lock
*.rblx.lock

# Studio auto-recovery / backups
*_AutoRecovery_*.rbxl
*.rbxl.bak

# Rojo build output (built places go here, not the root)
build/
sourcemap.json

# Wally packages (restored with `wally install`; wally.lock IS committed)
Packages/
ServerPackages/
DevPackages/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/extensions.json
.idea/

# Claude Code local settings
.claude/settings.local.json

# Blender generator output. The files needed to rebuild the game's art are kept (in Git LFS, see
# .gitattributes): models (.fbx), Blender sources (.blend), manifests and texture maps. Preview renders and
# Blender's .blend1 backups are not; regenerate them with tools/blender/*.py.
tools/blender/out/**
!tools/blender/out/**/
!tools/blender/out/**/*.fbx
!tools/blender/out/**/*.blend
!tools/blender/out/**/*_manifest.json
!tools/blender/out/**/*_Color.png
!tools/blender/out/**/*_Normal.png
!tools/blender/out/**/*_Roughness.png
!tools/blender/out/**/*_Metalness.png
!tools/blender/out/textures/sky/Sky_??.png
!tools/blender/out/textures/Border_Stripes.png
!tools/blender/out/Woods_Palette.png
!tools/blender/out/trees.txt

# Python bytecode (tools/blender scripts import each other)
__pycache__/
