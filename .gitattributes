* text=auto eol=lf
*.rbxl binary
*.rbxm binary
*.png binary
*.jpg binary

# Art assets in Git LFS (large binaries; the repository keeps small pointers)
tools/blender/out/**/*.fbx filter=lfs diff=lfs merge=lfs -text
tools/blender/out/**/*.blend filter=lfs diff=lfs merge=lfs -text
tools/blender/out/**/*.png filter=lfs diff=lfs merge=lfs -text

# Generated audio (tools/audio/ui_sounds.py), kept so it can be re-uploaded
tools/audio/out/**/*.wav filter=lfs diff=lfs merge=lfs -text

# Marketing video (tools/marketing/trailer_*.py)
docs/art/marketing/*.mp4 filter=lfs diff=lfs merge=lfs -text
